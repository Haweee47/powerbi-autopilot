table Calendar
	dataCategory: Time

	column Date
		isUnique
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month No'
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	column Month
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month No'

	column Quarter
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	partition Calendar = calculated
		mode: import
		source =
				ADDCOLUMNS ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2026, 12, 31 ) ), "Year", YEAR ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM", "en-US" ), "Quarter", "Q" & QUARTER ( [Date] ) )
