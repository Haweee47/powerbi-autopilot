  "styles": {
    "$comment": "Card shape, picked per theme. soft: the original look. bold: rounder corners, an invisible border (it only rounds the corners), a deeper shadow. flat: square corners, hairlines, no shadow.",
    "soft": {
      "radius": 12,
      "borderColor": "border",
      "shadow": true,
      "tileCurve": 6,
      "buttonCurve": 16
    },
    "bold": {
      "radius": 16,
      "borderColor": "surface",
      "shadow": true,
      "shadowTransparency": 86,
      "shadowBlur": 24,
      "shadowDistance": 4,
      "tileCurve": 10,
      "buttonCurve": 18
    },
    "flat": {
      "radius": 2,
      "borderColor": "border",
      "shadow": false,
      "tileCurve": 2,
      "buttonCurve": 2
    }
  },
  "font": {
    "$comment": "Default typeface set, kept so existing specs and themes resolve unchanged. A theme picks another with \"typeface\": see tokens.typefaces.",
    "family": "Segoe UI, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif",
    "semibold": "Segoe UI Semibold, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif"
  },
  "type": {
    "$comment": "5단계. Power BI는 pt, HTML은 px (1pt ≈ 1.33px).",
    "pt": {
      "caption": 9,
      "body": 10,
      "title": 12,
      "page": 18,
      "kpi": 24
    },
    "px": {
      "caption": 12,
      "body": 14,
      "title": 16,
      "page": 24,
      "kpi": 32
    }
  },
  "space": {
    "unit": 8,
    "gutter": 16,
    "margin": 24,
    "radius": 12,
    "padding": 16
  },
  "shadow": {
    "$comment": "카드 그림자: 거의 안 보일 만큼. 겹침이 아니라 '종이 한 장' 정도의 깊이",
    "transparency": 93,
    "blur": 16,
    "distance": 2,
    "spread": 0
  },
  "typefaces": {
    "$comment": "Typeface sets. Power BI renders only the fonts it ships (Segoe UI, DIN, Georgia, Corbel, Candara …); anything else falls back silently on the reader's machine. Latin faces carry no Hangul or Kana, so each set chains the same CJK fallbacks and CJK text keeps the system UI face in every set.",
    "segoe": {
      "name": "Segoe",
      "desc": "Power BI's own face. Neutral, ships everywhere, the safest default",
      "family": "Segoe UI, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif",
      "semibold": "Segoe UI Semibold, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif"
    },
    "din": {
      "name": "DIN",
      "desc": "Engineering signage face, also shipped by Power BI. Numbers read as instruments: operations and logistics",
      "family": "DIN, Segoe UI, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif",
      "semibold": "DIN, Segoe UI Semibold, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif"
    },
    "editorial": {
      "name": "Editorial",
      "desc": "Georgia headings over Corbel text. A written report rather than a console: board packs, monthly reviews",
      "family": "Corbel, Segoe UI, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, sans-serif",
      "semibold": "Georgia, Segoe UI Semibold, Malgun Gothic, Yu Gothic UI, Microsoft YaHei UI, serif"
    }
  }
}
