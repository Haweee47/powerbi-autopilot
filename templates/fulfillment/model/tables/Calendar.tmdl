table Calendar
	dataCategory: Time

	column Date
		isUnique
		formatString: yyyy-mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column 'Month No'
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month No]

	column Month
		summarizeBy: none
		sortByColumn: 'Month No'
		isNameInferred
		sourceColumn: [Month]

	column Quarter
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Week Start'
		formatString: mm-dd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Start]

	column 'Weekday No'
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday No]

	column Weekday
		summarizeBy: none
		sortByColumn: 'Weekday No'
		isNameInferred
		sourceColumn: [Weekday]

	column 'Day Label'
		summarizeBy: none
		sortByColumn: 'Day Order'
		isNameInferred
		sourceColumn: [Day Label]

	column 'Day Order'
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Day Order]

	column 'Week Label'
		summarizeBy: none
		sortByColumn: 'Week Order'
		isNameInferred
		sourceColumn: [Week Label]

	column 'Week Order'
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Order]

	partition Calendar = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2026, 1, 1 ), DATE ( 2026, 8, 31 ) ), "Year", YEAR ( [Date] ), "Month No", MONTH ( [Date] ), "Month", FORMAT ( [Date], "MMM", "en-US" ), "Quarter", "Q" & QUARTER ( [Date] ), "Week Start", [Date] - WEEKDAY ( [Date], 3 ), "Weekday No", WEEKDAY ( [Date], 2 ), "Weekday", FORMAT ( [Date], "ddd", "en-US" ), "Day Label", FORMAT ( [Date], "MM-dd" ), "Day Order", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ), "Week Label", FORMAT ( [Date] - WEEKDAY ( [Date], 3 ), "MM-dd" ), "Week Order", YEAR ( [Date] - WEEKDAY ( [Date], 3 ) ) * 10000 + MONTH ( [Date] - WEEKDAY ( [Date], 3 ) ) * 100 + DAY ( [Date] - WEEKDAY ( [Date], 3 ) ) )
