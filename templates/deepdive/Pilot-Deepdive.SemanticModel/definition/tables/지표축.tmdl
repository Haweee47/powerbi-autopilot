/// 레이더 차트의 축. 어느 테이블과도 연결하지 않는다 — 행 하나가 축 하나이고,
/// 값은 [축 원값]이 지금 선택된 축을 보고 계산한다. 순서는 '축 순서'가 정한다.
///
/// '축 ID'는 번역되지 않는 키다. 측정값은 보이는 이름('지표')이 아니라 이 키와 비교한다.
/// 이름으로 비교했더니 영어 빌드에서 "매출"이 "Sales"로 바뀌어 SWITCH가 어느 분기에도 걸리지
/// 않았고, 레이더가 통째로 비었다 (2026-09-18 풀필먼트에서 겪은 것과 같은 실수).
table 지표축

	column '축 ID'
		dataType: string
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [축 ID]

	column 지표
		dataType: string
		isUnique
		summarizeBy: none
		sortByColumn: '축 순서'
		isNameInferred
		sourceColumn: [지표]

	column '축 순서'
		dataType: int64
		isHidden
		summarizeBy: none
		isNameInferred
		sourceColumn: [축 순서]

	partition 지표축 = calculated
		mode: import
		source =
				DATATABLE (
				    "축 ID", STRING,
				    "지표", STRING,
				    "축 순서", INTEGER,
				    {
				        { "SALES", "Sales", 1 },
				        { "MARGIN", "Margin", 2 },
				        { "GROWTH", "Growth", 3 },
				        { "ORDERS", "Orders", 4 },
				        { "AOV", "Avg order", 5 },
				        { "AGE", "Store age", 6 }
				    }
				)
